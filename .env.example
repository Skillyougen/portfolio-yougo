# Variables d'environnement — portfolio YOUGO
#
# Vite fige les variables VITE_* au moment de la construction : après toute
# modification sur Vercel, redéployer le projet pour qu'elle soit prise en
# compte.

# Adresse de l'API, avec le préfixe /api.
# Facultative : sans elle, un build de production utilise
# https://backend-yougo.onrender.com/api et le mode développement localhost.
# Sans API joignable, le site affiche les données de secours de src/data.js.
VITE_API_URL=http://localhost:8000/api

# Destination de l'accès discret au back-office (5 clics sur le pied de page).
VITE_ADMIN_URL=https://admin-yougo.vercel.app

# ── Référencement ──────────────────────────────────────────
# Adresse publique du site (sans barre finale) : sert à la balise canonique,
# aux aperçus de partage, au sitemap.xml et au robots.txt générés au build.
# Par défaut : https://portfolio-yougo-qfli.vercel.app — à changer si tu
# ajoutes un nom de domaine.
VITE_SITE_URL=https://portfolio-yougo-qfli.vercel.app

# Codes de validation fournis par Google Search Console et Bing Webmaster
# Tools (méthode « balise HTML » : ne coller que la valeur de content="…").
# Le code Google actuel est déjà inscrit dans src/seo.js ; cette variable ne
# sert qu'à le remplacer.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
