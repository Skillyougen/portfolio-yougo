# Variables d'environnement — portfolio YOUGO
#
# Vite fige les variables VITE_* au moment de la construction : après toute
# modification sur Vercel, redéployer le projet pour qu'elle soit prise en
# compte.

# Adresse de l'API, avec le préfixe /api.
# Facultative : sans elle, un build de production utilise
# https://backend-yougo.onrender.com/api et le mode développement localhost.
# Sans API joignable, le site affiche les données de secours de src/data.js.
VITE_API_URL=http://localhost:8000/api

# Destination de l'accès discret au back-office (5 clics sur le pied de page).
VITE_ADMIN_URL=https://admin-yougo.vercel.app
